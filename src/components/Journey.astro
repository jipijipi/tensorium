---
import stages from '../data/journey.json';
import concepts from '../data/concepts.json';
import ConceptText from './ConceptText.astro';
import JourneyExample from './JourneyExample.astro';
import DescentDiagram from './DescentDiagram.astro';
---
<div id="journey-view">
  <header class="journey-intro">
    <p class="eyebrow">The big picture first</p>
    <h2>From text to a tiny language model.</h2>
    <p>Five questions explain the journey. Start with what each step does and why it matters. Open the mechanics when you’re ready.</p>
    <p class="journey-scope">Our destination is a small character-level transformer. This is a learning path toward building one; a live model and runnable build tutorial are still to come.</p>
  </header>
  <ol class="journey-overview" aria-label="Five stages of building a language model">
    {stages.map((stage, i) => <li data-tone={stage.id}><a href={`#journey-${stage.id}`} data-open-stage={stage.id}><span class="journey-number">0{i + 1}</span><strong>{stage.title}</strong><span>{stage.summary}</span></a></li>)}
  </ol>
  <p class="journey-invitation">See the whole path above. Open any question below.</p>
  <div class="journey-lessons">
    {stages.map((stage, i) => <details class="journey-stage" data-tone={stage.id} id={`journey-${stage.id}`} data-stage={stage.id}>
      <summary><span class="journey-number">0{i + 1}</span><span><span class="eyebrow">{stage.title}</span><strong>{stage.question}</strong></span><span class="expand-mark" aria-hidden="true">+</span></summary>
      <div class="journey-body">
        <div class="journey-purpose"><section><h3>What</h3><p><ConceptText text={stage.what} /></p></section><section><h3>Why</h3><p><ConceptText text={stage.why} /></p></section></div>
        <figure class="journey-example"><figcaption>{stage.exampleTitle}</figcaption><JourneyExample stage={stage.id} /><p>{stage.caption}</p></figure>
        <section class="journey-build"><h3>What you’ll build</h3><p><ConceptText text={stage.build} /></p></section>
        <details class="journey-deeper"><summary>Go deeper: the mechanics and supporting concepts</summary><p><ConceptText text={stage.how} /></p>
          <div class="journey-concepts">{stage.concepts.map(id => {
            const c = concepts.find(c => c.id === id)!;
            return <details><summary>{c.title}<span class="concept-category">{c.category}</span></summary><div class="inline-concept"><p><ConceptText text={c.intuition} /></p><h4>A concrete example</h4><p><ConceptText text={c.example} /></p>{id === 'gradient-descent' && <DescentDiagram />}<h4>What to remember</h4><p><ConceptText text={c.takeaway} /></p><details><summary>{c.question}</summary><p>{c.answer}</p></details><a class="text-link" href={`/concepts/${id}/`}>Full concept page ↗</a></div></details>;
          })}</div>
        </details>
        <details class="journey-check"><summary>Check your understanding: {stage.checkpoint}</summary><p>{stage.answer}</p></details>
        <p class="journey-bridge">{stage.next}</p>
        {stages[i + 1] && <a class="text-link" data-open-stage={stages[i + 1].id} href={`#journey-${stages[i + 1].id}`}>Continue to {stages[i + 1].title.toLowerCase()} <span aria-hidden="true">↓</span></a>}
      </div>
    </details>)}
  </div>
</div>
