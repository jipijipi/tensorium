---
interface Props { id: string }
const { id } = Astro.props;
---
{id === 'recipe' && <div class="neural-visual recipe-visual"><div><span class="visual-label">Token</span><strong>a</strong></div><span aria-hidden="true">→</span><div><span class="visual-label">ID selects a row</span><strong>1</strong></div><span aria-hidden="true">→</span><div><span class="visual-label">Embedding · adjustable settings</span><div class="vector-cells"><b>0.75<small>pattern A</small></b><b>0.25<small>pattern B</small></b></div></div></div>}
{id === 'weights' && <div class="neural-visual"><table class="pattern-table"><caption>One recipe → three output scores</caption><thead><tr><th>Contribution</th><th>t</th><th>r</th><th>n</th></tr></thead><tbody><tr><th>0.75 × A</th><td>1.50</td><td>0.75</td><td>0</td></tr><tr><th>0.25 × B</th><td>0</td><td>0.25</td><td>0.50</td></tr><tr class="score-total"><th>Add ↓</th><td>1.50</td><td>1.00</td><td>0.50</td></tr></tbody></table></div>}
{id === 'training' && <div class="neural-visual"><p class="visual-label">Compare prediction with observed proportions</p>{[['t',50.6,60],['r',30.7,30],['n',18.6,10]].map(([token,predicted,observed])=><div class="probability-pair"><strong>{token}</strong><div><span class="comparison-bar predicted" style={`--chance:${predicted}%`}>Prediction {predicted}%</span><span class="comparison-bar observed" style={`--chance:${observed}%`}>Observed {observed}%</span></div></div>)}</div>}
{id === 'positions' && <div class="neural-visual order-comparison">{['cat','act'].map(word=><div>{[...word].map((token,i)=><span class="position-cell"><small>position {i+1}</small><b>{token}</b></span>)}</div>)}<p>Same characters. Different positions.</p></div>}
{id === 'attention' && <div class="neural-visual"><p class="visual-label">Toy mixture · invented values</p><div class="attention-mixture"><span><b>25%</b><code>[1, 0]</code></span><strong>+</strong><span><b>75%</b><code>[0, 1]</code></span><strong>=</strong><span><b>Combined</b><code>[0.25, 0.75]</code></span></div><p class="causal-strip"><span>earlier positions → current position</span><span>future positions: hidden</span></p></div>}
{id === 'transformer' && <div class="neural-visual model-flow"><span>Token IDs</span><i>↓</i><span>Embeddings + positions</span><i>↓</i><div class="block-outline"><span>Causal attention</span><i>↓</i><span>Feedforward network</span><small>Residual paths + normalization</small></div><i>↓</i><span>Output scores → probabilities</span></div>}
{id === 'return-loop' && <div class="neural-visual converging-flow"><div><span>Count table</span><span>Neural calculation</span></div><p>↘ <span>Probabilities</span> ↙</p><strong>Choose → append → repeat → END</strong></div>}
