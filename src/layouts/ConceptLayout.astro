---
import BaseLayout from './BaseLayout.astro';
interface Props { frontmatter: { title: string; description: string; category: string; difficulty: string } }
const { frontmatter } = Astro.props;
---
<BaseLayout title={`${frontmatter.title} — Tensorium`} description={frontmatter.description}>
  <article class="concept-page">
    <a class="back-link" href="/#concepts">← All concepts</a>
    <header class="concept-heading">
      <p class="eyebrow">{frontmatter.category} <span aria-hidden="true">/</span> {frontmatter.difficulty}</p>
      <h1>{frontmatter.title}</h1>
      <p class="lede">{frontmatter.description}</p>
    </header>
    <div class="prose"><slot /></div>
  </article>
</BaseLayout>
