---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title = 'TensorAtlas — A visual atlas of machine learning', description = 'Explore machine learning, one clear explanation at a time.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="TensorAtlas home"><span class="brand-mark" aria-hidden="true">t_</span>tensoratlas</a>
      <nav aria-label="Main navigation">
        <a href="/#concepts">Atlas</a>
        <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
      </nav>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer shell"><span>TensorAtlas · An open learning project</span><a href="https://github.com/jipijipi/tensorium">GitHub <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
